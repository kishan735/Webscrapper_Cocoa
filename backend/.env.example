# ============================================================================
# COCOA PRICE TRACKER - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your API keys

# ============================================================================
# AI API KEYS (All have FREE tiers - choose at least one!)
# ============================================================================

# GROQ - RECOMMENDED (FREE, fast, Llama 3.3 70B)
# Get your free key at: https://console.groq.com/keys
# Free tier: 30 requests/minute, 6000 requests/day
GROQ_API_KEY=your_groq_api_key_here

# GOOGLE GEMINI - FREE tier available
# Get your free key at: https://aistudio.google.com/apikey
# Free tier: 15 requests/minute, 1500 requests/day
GEMINI_API_KEY=your_gemini_api_key_here

# HUGGING FACE - FREE tier available
# Get your free key at: https://huggingface.co/settings/tokens
# Free tier: Rate limited but generous
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# OPENAI - PAID (optional fallback)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/cocoa_tracker.db

# ============================================================================
# SCRAPER SETTINGS
# ============================================================================
SCRAPE_INTERVAL_MINUTES=30
NEWS_FETCH_LIMIT=50

# ============================================================================
# APP SETTINGS
# ============================================================================
APP_NAME=Cocoa Price Tracker
DEBUG=true
